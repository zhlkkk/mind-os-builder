{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/agent-job.schema.json",
  "title": "外层 Agent 任务清单 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "job", "execution"],
  "properties": {
    "version": {"const": "v1"},
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "inputs", "entry", "effects", "concurrency", "retry"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "inputs": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
            "skill": {"type": "string", "pattern": "^\\.agents/skills/[a-z0-9-]+/SKILL\\.md$"}
          },
          "oneOf": [
            {"required": ["command"], "not": {"required": ["skill"]}},
            {"required": ["skill"], "not": {"required": ["command"]}}
          ]
        },
        "effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["workspace.read", "workspace.write", "network.read"]}},
        "concurrency": {"enum": ["single", "parallel"]},
        "retry": {"type": "object", "additionalProperties": false, "required": ["max_attempts"], "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 3}}},
        "schedule": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "apply_authorized"],
      "properties": {
        "mode": {"const": "host-controlled"},
        "apply_authorized": {"const": false}
      }
    }
  }
}
