{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/distill-responses.schema.json",
  "title": "蒸馏回复 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseline_hash", "responses"],
  "properties": {
    "version": {"const": "v1"},
    "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "responses": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger_id", "persona", "callout"],
        "properties": {
          "trigger_id": {"type": "string", "pattern": "^distill:v1:[a-f0-9]{20}$"},
          "persona": {"enum": ["lumina", "prism", "vector", "nexus", "ember"]},
          "callout": {"type": "string", "minLength": 1, "maxLength": 20000}
        }
      }
    }
  }
}
