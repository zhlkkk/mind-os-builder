{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/collection-decisions.schema.json",
  "title": "采集决策 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decisions"],
  "properties": {
    "version": {"const": "v1"},
    "decisions": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["id", "decision"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "decision": {"enum": ["keep", "discard"]}}}}
  }
}
