{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/collection-decisions.schema.json",
  "title": "采集决策 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "batch_id", "baseline_hash", "decisions"],
  "properties": {
    "version": {"const": "v1"},
    "batch_id": {"type":"string","pattern":"^[a-f0-9]{32}$"},
    "baseline_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "decisions": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["id", "decision", "reason"], "properties": {"id": {"type": "string", "pattern":"^[\\w.:-]{1,256}$"}, "decision": {"enum": ["keep", "discard"]}, "reason":{"type":"string","minLength":1,"maxLength":2000}, "display_title":{"type":"string","minLength":1,"maxLength":500}, "display_summary":{"type":"string","minLength":1,"maxLength":4000}, "translated":{"type":"boolean"}, "category":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "tags":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":80}}}, "allOf":[{"if":{"properties":{"decision":{"const":"keep"}}},"then":{"required":["display_title","display_summary","translated","category"]}},{"if":{"properties":{"decision":{"const":"discard"}}},"then":{"not":{"anyOf":[{"required":["display_title"]},{"required":["display_summary"]},{"required":["translated"]},{"required":["category"]},{"required":["tags"]}]}}}]}}
  }
}
