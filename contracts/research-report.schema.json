{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/research-report.schema.json",
  "title": "技术调研候选报告 frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "topic", "mode", "researched_at", "evidence_status", "tools", "sources"],
  "properties": {
    "version": {"const": "v1"},
    "topic": {"type": "string", "minLength": 1, "maxLength": 500},
    "mode": {"enum": ["quick", "standard", "deep"]},
    "researched_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "evidence_status": {"enum": ["complete", "partial"]},
    "tools": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "maxLength": 2048, "format": "uri"}}
  }
}
