{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mind-os-builder.dev/contracts/job.schema.json",
  "title": "Mind OS 声明式任务 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "inputs", "effects", "concurrency", "retry"],
  "properties": {
    "version": {"const": "v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "inputs": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "(?:^|\\s)(?:sh|bash|zsh|fish|cmd|powershell)(?:\\s|$)|[|;&`]"}}
    },
    "skill": {"type": "string", "pattern": "^\\.agents/skills/[a-z0-9-]+/SKILL\\.md$"},
    "effects": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["workspace.read", "workspace.write", "network.read"]}, "uniqueItems": true},
    "concurrency": {"enum": ["single", "parallel"]},
    "retry": {"type": "object", "additionalProperties": false, "required": ["max_attempts"], "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 3}}},
    "schedule": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "oneOf": [
    {"required": ["command"], "not": {"required": ["skill"]}},
    {"required": ["skill"], "not": {"required": ["command"]}}
  ]
}
